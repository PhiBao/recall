# ---------------------------------------------------------------------------
# Recall — environment configuration
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# CockroachDB (Serverless on AWS). Use the connection string from the Cloud Console.
# Example: postgresql://user:pass@host:26257/recall?sslmode=verify-full
DATABASE_URL="postgresql://root@localhost:26257/recall?sslmode=disable"

# Session signing secret (generate a long random string, e.g. `openssl rand -base64 48`)
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# AWS Bedrock — chat uses the Mantle endpoint (OpenAI-compatible) with a
# Bedrock API key (Bedrock console > API keys). Embeddings additionally need
# classic IAM access keys (Titan runs on bedrock-runtime).
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_API_KEY=""
# Chat model via Mantle Chat Completions. Default: cheapest verified model
# (Voxtral Mini 3B, $0.04/M in / $0.04/M out).
BEDROCK_TEXT_MODEL_ID="mistral.voxtral-mini-3b-2507"
# Embedding model (Amazon Titan Text Embeddings V2 -> 1024 dims; needs IAM keys)
BEDROCK_EMBED_MODEL_ID="amazon.titan-embed-text-v2:0"
EMBED_DIMENSIONS="1024"

# Optional: set to "mock" to run the AI layer without AWS credentials (deterministic local demo)
AI_PROVIDER="bedrock"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
