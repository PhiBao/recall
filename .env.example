# ---------------------------------------------------------------------------
# Recall — environment configuration
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Session signing secret (generate a long random string, e.g. `openssl rand -base64 48`)
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# AWS Bedrock — chat uses the Mantle endpoint (OpenAI-compatible) with a
# Bedrock API key (Bedrock console > API keys). No IAM keys needed: prose
# generation only, embeddings live in Walrus Memory's relayer.
AWS_REGION="us-east-1"
BEDROCK_API_KEY=""
# Chat model via Mantle Chat Completions. Default: cheapest verified model
# (Voxtral Mini 3B, $0.04/M in / $0.04/M out — also the "Beyond the Big Two"
# hackathon track: not Anthropic/OpenAI).
BEDROCK_TEXT_MODEL_ID="mistral.voxtral-mini-3b-2507"

# Walrus Memory — the durable memory layer (one operator account; per-user
# isolation via namespace `recall-<userId>`). Generate at:
#   Mainnet: https://memory.walrus.xyz  (required for hackathon submission)
#   Testnet: https://staging.memory.walrus.xyz (local experiments)
# When unset, the app runs on its local projection only (no cross-session
# Walrus recall) — still fully demoable.
MEMWAL_PRIVATE_KEY=""
MEMWAL_ACCOUNT_ID=""
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"

# TypeSafe (Jev) — every *decision* in the pipeline: intent routing, person
# resolution, relevance ranking, citation verification. When unset, decisions
# fall back to Bedrock generative paths. Prose generation always stays on
# Bedrock/Voxtral. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=""
# TYPESAFE_MODEL_ID="jev-latest"

# Optional: override the local projection store path (defaults to ./data/recall.json)
# RECALL_DATA_PATH="./data/recall.json"

# Optional: set to "mock" to run the AI layer without AWS credentials (deterministic local demo)
AI_PROVIDER="bedrock"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
